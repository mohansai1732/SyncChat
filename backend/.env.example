# ==========================================
# SyncChat Backend Environment Configuration
# ==========================================

# Server Port
PORT=5000

# Environment mode ('development' or 'production')
NODE_ENV=production

# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority

# JWT Secret for Signing Authentication Tokens
# Generate a strong 32+ character random string
JWT_SECRET=your_super_secret_jwt_key_change_in_production

# Frontend Client URL (used for CORS and Socket.io allowed origins)
# Note: Trailing slashes are automatically handled by the server
CLIENT_URL=http://localhost:5173

# Cloudinary Configuration for Media & File Uploads
# Option 1: Full URL string
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Option 2: Individual variables
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
