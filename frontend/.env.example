# ==========================================
# SyncChat Frontend Environment Configuration
# ==========================================

# Backend API Base URL (Must end with /api)
# Local: http://localhost:5000/api
# Production: https://your-backend-service.onrender.com/api
VITE_API_URL=http://localhost:5000/api

# Backend Socket.io Server URL (Root domain, NO /api suffix)
# Local: http://localhost:5000
# Production: https://your-backend-service.onrender.com
VITE_SOCKET_URL=http://localhost:5000
